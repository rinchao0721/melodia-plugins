{
  "frame": {
    "split": 0.42,
    "header": "none",
    "cards": false,
    "lyricsPadding": [
      16,
      48
    ],
    "lyricsMaxWidth": 640,
    "canvas": "background/mist.js",
    "canvasColors": {
      "coverBase": "cover.base",
      "coverAccent": "cover.accent"
    },
    "canvasCover": true
  },
  "styles": {
    "dim": {
      "opacity": 0.62
    },
    "transport": {
      "variant": "plain",
      "size": "large"
    },
    "cover": {
      "shape": "rounded",
      "radius": 14,
      "weight": 1,
      "alignSelf": "center",
      "glow": {
        "color": "cover.palette0",
        "radius": 40,
        "opacity": 0.55,
        "offset": [
          0,
          16
        ]
      },
      "animation": {
        "preset": "scaleOnPause",
        "scale": 0.86
      },
      "onDoubleTap": "toggleLike"
    }
  },
  "layout": {
    "type": "column",
    "padding": [
      8,
      16,
      12,
      16
    ],
    "children": [
      {
        "type": "row",
        "height": 48,
        "align": "center",
        "children": [
          {
            "type": "collapseButton"
          },
          {
            "type": "sourceLabel",
            "weight": 1,
            "class": "dim"
          },
          {
            "type": "moreButton"
          }
        ]
      },
      {
        "type": "box",
        "weight": 1,
        "align": "center",
        "padding": [
          8,
          8,
          24,
          8
        ],
        "children": [
          {
            "type": "cover",
            "class": "cover"
          }
        ]
      },
      {
        "type": "songTitle",
        "size": "large"
      },
      {
        "type": "artist",
        "size": "medium",
        "class": "dim"
      },
      {
        "type": "spacer",
        "height": 16
      },
      {
        "type": "progress",
        "showTime": true
      },
      {
        "type": "spacer",
        "height": 8
      },
      {
        "type": "row",
        "arrange": "spaceEvenly",
        "align": "center",
        "children": [
          {
            "type": "controls",
            "buttons": [
              "previous"
            ],
            "class": "transport"
          },
          {
            "type": "controls",
            "buttons": [
              "playPause"
            ],
            "class": "transport"
          },
          {
            "type": "controls",
            "buttons": [
              "next"
            ],
            "class": "transport"
          }
        ]
      },
      {
        "type": "spacer",
        "height": 12
      },
      {
        "type": "row",
        "arrange": "spaceBetween",
        "align": "center",
        "children": [
          {
            "type": "likeButton"
          },
          {
            "type": "controls",
            "buttons": [
              "playMode"
            ]
          },
          {
            "type": "actions",
            "buttons": [
              "comments"
            ]
          },
          {
            "type": "actions",
            "buttons": [
              "sleepTimer"
            ]
          },
          {
            "type": "actions",
            "buttons": [
              "share"
            ]
          },
          {
            "type": "actions",
            "buttons": [
              "queue"
            ]
          }
        ]
      }
    ]
  }
}
